{
	"name": "acpantenna-workspace",
	"module": "index.ts",
	"type": "module",
	"private": true,
	"packageManager": "bun@1.4.3",
	"bin": {
		"acpantenna": "./packages/cli/src/main.ts"
	},
	"scripts": {
		"acpantenna": "bun run packages/cli/src/main.ts",
		"check": "bunx biome check .",
		"dev": "bun run packages/cli/src/main.ts serve",
		"format": "bunx biome format --write .",
		"format:check": "bunx biome format .",
		"lint": "bunx biome lint .",
		"precommit": "bun run check && bun run typecheck && bun run test",
		"prepare": "husky || true",
		"start": "bun run packages/cli/src/main.ts serve",
		"test": "turbo run test",
		"test:direct": "bun test",
		"test:e2e": "bun test tests packages/channel-matrix/e2e",
		"typecheck": "turbo run typecheck",
		"typecheck:direct": "bunx tsc --noEmit",
		"verify": "bun run check && bun run typecheck && bun run test"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.9",
		"@types/bun": "latest",
		"husky": "^9.1.7",
		"turbo": "2.9.18",
		"typescript": "^5"
	},
	"workspaces": [
		"packages/*"
	],
	"patchedDependencies": {
		"@matrix-org/matrix-sdk-crypto-wasm@18.9.0": "patches/@matrix-org%2Fmatrix-sdk-crypto-wasm@18.9.0.patch"
	}
}
