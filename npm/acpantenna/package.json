		"dist",
		"README.md",
		"LICENSE",
		"THIRD_PARTY_LICENSES.md"
	],
	"engines": {
		"node": ">=18"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fboldo/acpantenna.git"
	},
	"homepage": "https://github.com/fboldo/acpantenna#readme",
	"bugs": "https://github.com/fboldo/acpantenna/issues",
	"keywords": [
		"acp",
		"agent-client-protocol",
		"claude-code",
		"codex",
		"opencode",
		"remote",
		"mobile",
		"qr-code",
		"end-to-end-encryption",
		"matrix",
		"agents",
		"cli"
	],
	"scripts": {
		"build": "bun run scripts/build.ts",
		"prepack": "bun run scripts/build.ts"
	},
	"dependencies": {
