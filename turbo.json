{
	"$schema": "https://turborepo.com/schema.json",
	"ui": "stream",
	"globalDependencies": [
		"tsconfig.json",
		"biome.json",
		"bun.lock",
		".github/workflows/**"
	],
	"tasks": {
		"typecheck": {
			"dependsOn": ["^typecheck"],
			"inputs": [
				"src/**",
				"e2e/**",
				"package.json",
				"tsconfig.json",
				"../../tsconfig.json"
			],
			"outputs": []
		},
		"test": {
			"dependsOn": ["^typecheck"],
			"inputs": [
				"src/**",
				"e2e/**",
				"package.json",
				"tsconfig.json",
				"../../tsconfig.json"
			],
			"outputs": []
		}
	}
}
